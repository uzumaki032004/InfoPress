@model List<InfoPress.Interfaces.IArticol>
@using InfoPress.Models
@{
    ViewData["Title"] = "Portal Știri";
    var articles = Model.Cast<NewsArticle>().ToList();
    var heroArticle = articles.FirstOrDefault();
    var otherArticles = articles.Skip(1).ToList();
    var trending = articles.OrderByDescending(a => a.ViewCount).Take(5).ToList();
}

<div class="container mt-4">
    <!-- Hero Section -->
    @if (heroArticle != null)
    {
        <div class="row mb-5 animate-fade-in">
            <div class="col-12">
                <div class="hero-card position-relative shadow-lg border-0">
                    <img src="@(string.IsNullOrEmpty(heroArticle.ImageUrl) ? "/images/hero-placeholder.jpg" : heroArticle.ImageUrl)" 
                         class="w-100" style="height: 550px; object-fit: cover;" alt="@heroArticle.Title"
                         onerror="this.src='https://images.unsplash.com/photo-1585829365234-781fdec3d4e3?w=1200&q=80'; this.onerror=null;">
                    <div class="hero-overlay">
                        <span class="badge bg-primary mb-3 px-3 py-2">@heroArticle.Category</span>
                        <h1 class="display-3 fw-bold mb-3">
                            <a asp-action="Detail" asp-route-id="@heroArticle.Id" class="text-white text-decoration-none">@heroArticle.Title</a>
                        </h1>
                        <p class="lead mb-4 opacity-75">@heroArticle.Summary</p>
                        <div class="d-flex align-items-center">
                            <img src="https://ui-avatars.com/api/?name=Admin&background=random" class="rounded-circle me-2" width="40" height="40" alt="Author">
                            <span class="small fw-bold">@heroArticle.Author</span>
                            <span class="mx-2 opacity-50">•</span>
                            <span class="small opacity-75">@heroArticle.CreatedDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Content Grid + Sidebar -->
    <div class="row">
        <!-- Main News Grid -->
        <div class="col-lg-8">
            <h3 class="sidebar-title mb-4">Ultimele Știri</h3>
            <div class="row g-4">
                @foreach (var article in otherArticles)
                {
                    <div class="col-md-6 animate-fade-in">
                        <div class="card h-100 news-card rounded-4">
                            <div class="card-img-container rounded-top-4">
                                <img src="@(string.IsNullOrEmpty(article.ImageUrl) ? "/images/news-placeholder.jpg" : article.ImageUrl)" 
                                     class="card-img-top" alt="@article.Title" style="height: 220px; object-fit: cover;"
                                     onerror="this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1200&q=80'; this.onerror=null;">
                            </div>
                            <div class="card-body p-4 d-flex flex-column">
                                <span class="text-primary small fw-bold mb-2">@article.Category.ToUpper()</span>
                                <h4 class="card-title fw-bold mb-3 h5">
                                    <a asp-action="Detail" asp-route-id="@article.Id" class="text-dark text-decoration-none">@article.Title</a>
                                </h4>
                                <p class="card-text text-muted small mb-4 text-truncate-3">@article.Summary</p>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <div class="small text-muted">@article.CreatedDate.ToString("dd.MM.yyyy")</div>
                                    <a asp-action="Detail" asp-route-id="@article.Id" class="btn btn-link p-0 text-primary text-decoration-none fw-bold small">Citește mai mult <i class="bi bi-chevron-right small"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (ViewData["TotalPages"] != null && (int)ViewData["TotalPages"] > 1)
            {
                <nav class="mt-5">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
                        {
                            <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                                <a class="page-link rounded-circle mx-1" asp-action="Index" asp-route-page="@i" asp-route-category="@ViewData["CurrentCategory"]">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4 mt-5 mt-lg-0">
            <!-- Sorting Strategy Widget -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Sortează după</h5>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" asp-route-sortBy="date" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 @(ViewData["CurrentSort"]?.ToString() == "date" ? "bg-light text-primary fw-bold" : "")">
                        <i class="bi bi-calendar-event me-2"></i> Data publicării
                    </a>
                    <a asp-action="Index" asp-route-sortBy="title" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 @(ViewData["CurrentSort"]?.ToString() == "title" ? "bg-light text-primary fw-bold" : "")">
                        <i class="bi bi-sort-alpha-down me-2"></i> Titlu (A-Z)
                    </a>
                    <a asp-action="Index" asp-route-sortBy="views" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 @(ViewData["CurrentSort"]?.ToString() == "views" ? "bg-light text-primary fw-bold" : "")">
                        <i class="bi bi-graph-up-arrow me-2"></i> Cele mai citite
                    </a>
                </div>
            </div>

            <!-- Trending News Modernized -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="sidebar-title">Trending</h5>
                <div class="mt-2">
                    @for (int i = 0; i < trending.Count; i++)
                    {
                        var t = trending[i];
                        <a asp-action="Detail" asp-route-id="@t.Id" class="trending-card">
                            <div class="trending-number">0@(i + 1)</div>
                            <div class="trending-content">
                                <div class="trending-meta">@t.Category</div>
                                <div class="trending-title">@t.Title</div>
                                <div class="trending-views">
                                    <i class="bi bi-eye me-1"></i> @t.ViewCount vizualizări
                                </div>
                            </div>
                            <img src="@(string.IsNullOrEmpty(t.ImageUrl) ? "/images/news-placeholder.jpg" : t.ImageUrl)" 
                                 class="trending-thumb" alt="@t.Title"
                                 onerror="this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=400&q=80'; this.onerror=null;">
                        </a>
                    }
                </div>
            </div>

            <!-- Newsletter Card -->
            <div class="card border-0 bg-primary text-white shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">Newsletter</h5>
                <p class="small opacity-75 mb-3">Fii la curent cu cele mai importante știri ale zilei.</p>
                <div class="input-group mb-0">
                    <input type="email" class="form-control rounded-start-pill border-0" placeholder="Emailul tău">
                    <button class="btn btn-dark rounded-end-pill px-3" type="button">OK</button>
                </div>
            </div>
        </div>
    </div>
</div>
