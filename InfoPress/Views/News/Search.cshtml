@model List<InfoPress.Models.NewsArticle>
@{
    ViewData["Title"] = "Rezultate căutare: " + ViewData["Query"];
    var query = ViewData["Query"] as string;
    var total = (int)ViewData["TotalResults"];
    var currentPage = (int)ViewData["CurrentPage"];
    var totalPages = (int)ViewData["TotalPages"];
}

<div class="container mt-4">
    <div class="mb-5">
        <h1 class="fw-bold">Rezultate pentru "@query"</h1>
        <p class="text-muted">Am găsit @total rezultate.</p>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var article in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 news-card">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(article.ImageUrl) ? "/images/news-placeholder.jpg" : article.ImageUrl)" 
                                 class="card-img-top rounded-top-4" alt="@article.Title" style="height: 200px; object-fit: cover;"
                                 onerror="this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1200&q=80'; this.onerror=null;">
                            <span class="badge bg-primary position-absolute top-0 start-0 m-3 rounded-pill px-3">@article.Category</span>
                        </div>
                        <div class="card-body p-4 d-flex flex-column">
                            <h4 class="card-title fw-bold mb-3">
                                <a asp-action="Detail" asp-route-id="@article.Id" class="text-dark text-decoration-none">@article.Title</a>
                            </h4>
                            <p class="card-text text-secondary small mb-4 text-truncate-3">@article.Summary</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="text-muted small">@article.CreatedDate.ToString("dd.MM.yyyy")</span>
                                <a asp-action="Detail" asp-route-id="@article.Id" class="btn btn-outline-dark btn-sm rounded-pill px-3">Citește</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-circle mx-1" asp-action="Search" asp-route-q="@query" asp-route-page="@(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link rounded-circle mx-1" asp-action="Search" asp-route-q="@query" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link rounded-circle mx-1" asp-action="Search" asp-route-q="@query" asp-route-page="@(currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-search display-1 text-muted mb-4"></i>
            <h3>Nu am găsit niciun rezultat pentru "@query"</h3>
            <p class="text-muted">Încearcă alte cuvinte cheie.</p>
            <a asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-3">Înapoi la prima pagină</a>
        </div>
    }
</div>
