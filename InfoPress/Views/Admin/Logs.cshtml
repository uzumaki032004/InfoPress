@model List<string>
@{
    ViewData["Title"] = "Log Notificări (Observer)";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Log Notificări</h1>
        <span class="badge bg-info rounded-pill px-3">Observer Pattern Activ</span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="list-group list-group-flush">
            @if (Model.Any())
            {
                @foreach (var log in Model.AsEnumerable().Reverse())
                {
                    <div class="list-group-item border-0 border-bottom py-3">
                        <i class="bi bi-info-circle text-primary me-2"></i> @log
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-journal-x display-4 mb-3 d-block"></i>
                    Nicio notificare înregistrată încă.
                </div>
            }
        </div>
    </div>
</div>
