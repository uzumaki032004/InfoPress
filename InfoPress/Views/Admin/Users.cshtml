@model List<InfoPress.Models.AppUser>
@{
    ViewData["Title"] = "Utilizatori înregistrați";
}

<div class="container mt-4">
    <h1 class="fw-bold mb-4">Utilizatori</h1>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Nume Afișat</th>
                        <th>Email</th>
                        <th>Data înscrierii</th>
                        <th>Newsletter</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td class="text-muted small">@user.RegisteredDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (user.IsSubscribedToNewsletter)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill"></i> Da</span>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-x-circle"></i> Nu</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
