@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <div class="row mb-5">
        <div class="col-12">
            <h1 class="fw-bold">Panou Administrare</h1>
            <p class="text-muted">Gestionare conținut, utilizatori și monitorizare sistem.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Articles Card -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body">
                    <div class="display-4 text-primary mb-3">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                    <h3 class="fw-bold">Articole</h3>
                    <p class="text-muted">Creează, editează sau șterge știri.</p>
                    <a asp-action="Articles" class="btn btn-primary rounded-pill px-4">Gestionare</a>
                </div>
            </div>
        </div>

        <!-- Users Card -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body">
                    <div class="display-4 text-success mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3 class="fw-bold">Utilizatori</h3>
                    <p class="text-muted">Vezi lista utilizatorilor înregistrați.</p>
                    <a asp-action="Users" class="btn btn-success rounded-pill px-4">Vezi Lista</a>
                </div>
            </div>
        </div>

        <!-- Logs Card -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body">
                    <div class="display-4 text-info mb-3">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <h3 class="fw-bold">Loguri Sistem</h3>
                    <p class="text-muted">Monitorizare Observer Pattern.</p>
                    <a asp-action="Logs" class="btn btn-info rounded-pill px-4">Vezi Loguri</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 p-4 bg-light rounded-4 border border-info border-opacity-25">
        <h5 class="fw-bold text-info"><i class="bi bi-gear-fill me-2"></i>Configurație Site (Singleton)</h5>
        <p class="mb-0">Nume site activ: <strong>@ViewData["SiteName"]</strong></p>
    </div>
</div>
