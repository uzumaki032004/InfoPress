@model InfoPress.DTO.ArticleCreateDto
@{
    ViewData["Title"] = "Editare Articol";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <h2 class="fw-bold mb-4">Editează Articol</h2>
                
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Titlu Articol</label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="Introdu titlul articolului">
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-bold">Categorie</label>
                            <select asp-for="Category" class="form-select rounded-3">
                                <option value="Politica">Politică</option>
                                <option value="Economie">Economie</option>
                                <option value="Tehnologie">Tehnologie</option>
                                <option value="Sport">Sport</option>
                                <option value="Editorial">Editorial</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Image" class="form-label fw-bold">Schimbă Imaginea (opțional)</label>
                            <input asp-for="Image" type="file" class="form-control rounded-3">
                            @if (ViewData["ExistingImageUrl"] != null)
                            {
                                <div class="mt-1 small text-muted">
                                    <i class="bi bi-image me-1"></i> Imagine actuală: <a href="@ViewData["ExistingImageUrl"]" target="_blank" class="text-primary text-decoration-none">Vezi</a>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-bold">Informație de Bază (Publică)</label>
                        <p class="text-muted x-small mb-2">Acest text este vizibil pentru toți cititorii.</p>
                        <textarea asp-for="Summary" class="form-control rounded-3" rows="3" placeholder="Scurtă descriere..."></textarea>
                    </div>

                    <div class="card border-0 bg-light rounded-4 p-3 mb-4 transition-all @(Model.IsPremium ? "border border-warning border-2" : "")" 
                         id="content-container" style="@(Model.IsPremium ? "background-color: #fffef0;" : "")">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label asp-for="ContentText" class="form-label fw-bold mb-0">Conținut Complet</label>
                            <div class="form-check form-switch">
                                <input asp-for="IsPremium" class="form-check-input" type="checkbox" id="isPremiumToggle">
                                <label class="form-check-label fw-bold text-warning" for="isPremiumToggle">Marchează ca PREMIUM</label>
                            </div>
                        </div>
                        <p id="premium-notice" class="text-warning small mb-2 @(Model.IsPremium ? "" : "d-none")">
                            <i class="bi bi-star-fill"></i> Acest conținut va fi BLURAT pentru utilizatorii fără abonament!
                        </p>
                        <textarea asp-for="ContentText" id="articleContent" class="form-control rounded-3 border-0 shadow-sm" rows="10" placeholder="Scrie restul articolului aici..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">Salvează Modificările</button>
                        <a asp-action="Articles" class="btn btn-outline-secondary rounded-pill px-4 py-2">Anulează</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const toggle = document.getElementById('isPremiumToggle');
        const container = document.getElementById('content-container');
        const notice = document.getElementById('premium-notice');

        toggle.addEventListener('change', function() {
            if (this.checked) {
                container.classList.add('border', 'border-warning', 'border-2');
                container.style.backgroundColor = '#fffef0';
                notice.classList.remove('d-none');
            } else {
                container.classList.remove('border', 'border-warning', 'border-2');
                container.style.backgroundColor = '';
                notice.classList.add('d-none');
            }
        });
    </script>
}
