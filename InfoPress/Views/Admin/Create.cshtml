@model InfoPress.DTO.ArticleCreateDto
@{
    ViewData["Title"] = "Creare Articol";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <h2 class="fw-bold mb-4">Adaugă Articol</h2>
                
                <!-- Builder Pattern Trigger -->
                <div class="bg-light p-3 rounded-3 mb-4 d-flex align-items-center justify-content-between border border-primary border-opacity-25">
                    <div>
                        <h6 class="fw-bold mb-1">Generează din șablon</h6>
                        <p class="text-muted small mb-0">Folosește Builder Pattern pentru a completa rapid câmpurile.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <select id="templateSelect" class="form-select form-select-sm" style="width: 150px;">
                            <option value="Stire">Știre</option>
                            <option value="Sport">Sport</option>
                            <option value="Editorial">Editorial</option>
                        </select>
                        <button type="button" onclick="applyTemplate()" class="btn btn-primary btn-sm rounded-pill px-3">Aplică</button>
                    </div>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Titlu Articol</label>
                        <input asp-for="Title" id="articleTitle" class="form-control rounded-3" placeholder="Introdu titlul articolului">
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-bold">Categorie</label>
                            <select asp-for="Category" id="articleCategory" class="form-select rounded-3">
                                <option value="Politica">Politică</option>
                                <option value="Economie">Economie</option>
                                <option value="Tehnologie">Tehnologie</option>
                                <option value="Sport">Sport</option>
                                <option value="Editorial">Editorial</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Image" class="form-label fw-bold">Imagine Header</label>
                            <input asp-for="Image" type="file" class="form-control rounded-3">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-bold">Informație de Bază (Publică)</label>
                        <p class="text-muted x-small mb-2">Acest text va fi vizibil pentru TOȚI utilizatorii, chiar și la articolele Premium.</p>
                        <textarea asp-for="Summary" id="articleSummary" class="form-control rounded-3" rows="3" placeholder="Scurtă descriere sau introducere..."></textarea>
                    </div>

                    <div class="card border-0 bg-light rounded-4 p-3 mb-4 transition-all" id="content-container">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label asp-for="ContentText" class="form-label fw-bold mb-0">Conținut Complet</label>
                            <div class="form-check form-switch">
                                <input asp-for="IsPremium" class="form-check-input" type="checkbox" id="isPremiumToggle">
                                <label class="form-check-label fw-bold text-warning" for="isPremiumToggle">Marchează ca PREMIUM</label>
                            </div>
                        </div>
                        <p id="premium-notice" class="text-warning small mb-2 d-none">
                            <i class="bi bi-star-fill"></i> Acest conținut va fi BLURAT pentru utilizatorii fără abonament!
                        </p>
                        <textarea asp-for="ContentText" id="articleContent" class="form-control rounded-3 border-0 shadow-sm" rows="10" placeholder="Scrie restul articolului aici..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold">Publică Articol</button>
                        <a asp-action="Articles" class="btn btn-outline-secondary rounded-pill px-4 py-2">Anulează</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const toggle = document.getElementById('isPremiumToggle');
        const container = document.getElementById('content-container');
        const notice = document.getElementById('premium-notice');

        toggle.addEventListener('change', function() {
            if (this.checked) {
                container.classList.add('border', 'border-warning', 'border-2');
                container.style.backgroundColor = '#fffef0';
                notice.classList.remove('d-none');
            } else {
                container.classList.remove('border', 'border-warning', 'border-2');
                container.style.backgroundColor = '';
                notice.classList.add('d-none');
            }
        });

        async function applyTemplate() {
            const template = document.getElementById('templateSelect').value;
            const response = await fetch(`/Admin/GetTemplate?type=${template}`);
            const data = await response.json();
            
            document.getElementById('articleTitle').value = data.title;
            document.getElementById('articleContent').value = data.content;
            document.getElementById('articleCategory').value = data.category;
            document.getElementById('articleSummary').value = data.title + " - un articol de tip " + template + ".";
            
            alert('Șablon aplicat cu succes!');
        }
    </script>
}
