@using InfoPress.Helpers
@using Microsoft.AspNetCore.Identity
@using InfoPress.Models
@using InfoPress.Repositories
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IArticleRepository ArticleRepository

@{
    var articles = await ArticleRepository.GetAllAsync(pageSize: 3);
    var breakingArticles = articles;
}

<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InfoPress</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InfoPress.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Breaking News Bar -->
    <div class="breaking-bar py-2">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <span class="badge bg-white text-danger fw-bold me-2">BREAKING NEWS</span>
                <a id="breaking-news-link" href="#" class="text-white text-decoration-none small animate-fade-in" style="transition: opacity 0.5s ease;">
                    <span id="breaking-news-content">Încărcare noutăți...</span>
                </a>
            </div>
            <div id="current-date-container" class="d-none d-md-block small opacity-75">
                <i class="bi bi-clock me-1"></i> <span id="current-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ro-RO"))</span>
            </div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3 text-dark" asp-area="" asp-controller="News" asp-action="Index">
                    <span class="text-primary">Info</span>Press
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="News" asp-action="Index">Acasă</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-primary" asp-controller="News" asp-action="Browse"><i class="bi bi-book-half me-1"></i> Sequential Reader</a>
                        </li>
                        @foreach (var sub in CategoryManager.GetMenuHierarchy().Subcategorii)
                        {
                            if (sub is InfoPress.Composite.CategorieCompusa comp)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle fw-semibold text-dark" href="#" id="navbarDropdown_@comp.Nume" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @comp.Nume
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3 animate-fade-in mt-2" aria-labelledby="navbarDropdown_@comp.Nume">
                                        @foreach (var child in comp.Subcategorii)
                                        {
                                            <li>
                                                <a class="dropdown-item py-2 px-3 fw-medium text-muted" asp-controller="News" asp-action="Index" asp-route-category="@child.Nume">@child.Nume</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-semibold text-dark" asp-controller="News" asp-action="Index" asp-route-category="@sub.Nume">@sub.Nume</a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Search Bar -->
                    <form asp-controller="News" asp-action="Search" method="get" class="d-flex mx-lg-3 my-2 my-lg-0">
                        <div class="input-group">
                            <input name="q" class="form-control border-end-0 rounded-start-pill ps-3" placeholder="Caută..." aria-label="Search" style="width: 150px;">
                            <button class="btn btn-outline-secondary border-start-0 rounded-end-pill pe-3" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-2">
                            <a class="btn btn-warning rounded-pill px-4 btn-sm fw-bold" asp-controller="Subscription" asp-action="Index">
                                <i class="bi bi-star-fill me-1"></i> PREMIUM
                            </a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold text-primary" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @(UserManager.GetUserAsync(User).Result?.DisplayName ?? User.Identity?.Name)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item fw-bold text-danger" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-shield-lock me-2"></i> Admin Panel</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-item p-0">
                                            <button type="submit" class="btn btn-link dropdown-item py-1">
                                                <i class="bi bi-box-arrow-right me-2"></i> Deconectare
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-bold" asp-controller="Account" asp-action="Login">Autentificare</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <!-- Global TempData Message -->
        @if (TempData["Message"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-alert="dismiss" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-dark text-white pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <h4 class="fw-bold mb-0 text-white"><span class="text-primary">Info</span>Press</h4>
                    <p class="small text-white-50 mb-0">Platformă de știri bazată pe arhitectură ASP.NET Core MVC.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="small text-white-50 mb-0">&copy; 2026 InfoPress - Arhitectură cu Design Patterns.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Breaking News Logic -->
    <script>
        const newsItems = [
            @if (breakingArticles != null && breakingArticles.Any())
            {
                foreach (var art in breakingArticles)
                {
                    <text>{ title: "@Html.Raw(art.Title)", url: "@Url.Action("Detail", "News", new { id = art.Id })" },</text>
                }
            }
            else
            {
                <text>{ title: "Noi reglementări economice anunțate astăzi de guvern...", url: "#" },</text>
                <text>{ title: "O nouă descoperire în domeniul energiei regenerabile...", url: "#" },</text>
                <text>{ title: "Echipele de top se pregătesc pentru finala istorică...", url: "#" },</text>
            }
        ];

        let currentNewsIndex = 0;
        const breakingContent = document.getElementById('breaking-news-content');
        const breakingLink = document.getElementById('breaking-news-link');

        function updateBreakingNews() {
            if(breakingContent && newsItems.length > 0) {
                if(breakingLink) breakingLink.style.opacity = 0;
                setTimeout(() => {
                    if(breakingContent) breakingContent.innerText = newsItems[currentNewsIndex].title;
                    if(breakingLink) breakingLink.href = newsItems[currentNewsIndex].url;
                    if(breakingLink) breakingLink.style.opacity = 1;
                    currentNewsIndex = (currentNewsIndex + 1) % newsItems.length;
                }, 500);
            }
        }

        if(newsItems.length > 0) {
            updateBreakingNews();
            setInterval(updateBreakingNews, 5000);
        }

        // Live Date Update in Romanian
        function updateLiveDate() {
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const now = new Date();
            let dateStr = now.toLocaleDateString('ro-RO', options);
            // Capitalize first letter
            dateStr = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
            const dateElem = document.getElementById('current-date');
            if(dateElem) dateElem.innerText = dateStr;
        }
        updateLiveDate();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)
</body>
</html>
