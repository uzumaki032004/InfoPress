@using InfoPress.Helpers
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InfoPress</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InfoPress.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3 text-dark" asp-area="" asp-controller="News" asp-action="Index">
                    <span class="text-primary">Info</span>Press
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">Acasă</a>
                        </li>
                        
                        <!-- Categorii dinamice (Demonstrație Composite în spate) -->
                        @foreach (var cat in CategoryManager.GetFlatCategories())
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="News" asp-action="Index" asp-route-category="@cat">@cat</a>
                            </li>
                        }

                        <li class="nav-item dropdown ms-lg-3">
                            <a class="nav-link dropdown-toggle btn btn-outline-dark rounded-pill px-3" href="#" id="patternsDropdown" role="button" data-bs-toggle="dropdown">
                                Demonstrații Patterns
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li><a class="dropdown-item" asp-controller="News" asp-action="Browse"><i class="bi bi-list-ol me-2"></i> Iterator - Navigare</a></li>
                                <li><a class="dropdown-item" asp-controller="ArticleEditor" asp-action="Index"><i class="bi bi-pencil-square me-2"></i> Memento - Editor</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item fw-bold text-primary" asp-controller="Admin" asp-action="Index" asp-route-role="Admin"><i class="bi bi-shield-lock me-2"></i> Admin Panel (Proxy)</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container text-center text-white-50 small">
            &copy; 2026 InfoPress - Arhitectură avansată cu Design Patterns.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
