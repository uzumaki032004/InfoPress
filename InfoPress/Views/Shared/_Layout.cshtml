<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InfoPress</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3 text-dark" asp-area="" asp-controller="News" asp-action="Index">
                    <span class="text-primary">Info</span>Press
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" asp-area="" asp-controller="News" asp-action="Index">Acasă</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Politică</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Economie</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Tehnologie</a>
                        </li>
                        <li class="nav-item ms-lg-3">
                            <button class="btn btn-primary rounded-pill px-4">Abonare</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white pt-5 pb-3">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <h5 class="fw-bold mb-3 text-primary">InfoPress</h5>
                    <p class="text-white-50 small pe-lg-5">
                        Jurnalism de elită pentru cititori informați. Acoperim cele mai importante subiecte ale zilei cu obiectivitate și profesionalism.
                    </p>
                </div>
                <div class="col-lg-3 col-6">
                    <h6 class="fw-bold mb-3">Link-uri</h6>
                    <ul class="list-unstyled small text-white-50">
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Confidențialitate</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Termeni și condiții</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-reset text-decoration-none">Despre noi</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-6">
                    <h6 class="fw-bold mb-3">Contact</h6>
                    <ul class="list-unstyled small text-white-50">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2"></i> București, România</li>
                        <li class="mb-2"><i class="bi bi-envelope me-2"></i> contact@infopress.ro</li>
                    </ul>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-white-50 fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white-50 fs-5"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-white-50 fs-5"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary">
            <div class="text-center text-white-50 small">
                &copy; 2026 InfoPress. Toate drepturile rezervate.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
