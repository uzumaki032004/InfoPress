@{
    ViewData["Title"] = "Checkout Premium";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <h2 class="fw-bold mb-4 text-center">Finalizare Plată</h2>
                
                <div class="bg-light p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small">Plan selectat:</span>
                        <div class="fw-bold">@ViewBag.Plan</div>
                    </div>
                    <div class="h4 fw-bold text-primary mb-0">@ViewBag.Price</div>
                </div>

                <form asp-action="ProcessPayment" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nume pe card</label>
                        <input type="text" name="cardName" class="form-control rounded-3" placeholder="Popescu Ion" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Număr Card</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-credit-card"></i></span>
                            <input type="text" name="cardNumber" class="form-control border-start-0 rounded-end-3" placeholder="0000 0000 0000 0000" required>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label fw-bold">Expira la</label>
                            <input type="text" class="form-control rounded-3" placeholder="MM/YY" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">CVV</label>
                            <input type="password" class="form-control rounded-3" placeholder="***" required>
                        </div>
                    </div>

                    <div class="alert alert-info small rounded-3">
                        <i class="bi bi-shield-check me-2"></i> Tranzacție securizată SSL. Datele tale sunt protejate.
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill w-100 py-3 fw-bold mt-2">
                        Activează Abonamentul Acum
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
